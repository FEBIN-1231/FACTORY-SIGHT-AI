# SNS Agent Workbench Webhook
VITE_SNS_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/inspectsight

# Computer Vision / YOLOv8 Detection Service (Cloud Deployed on Render)
VITE_CV_API_URL=https://factory-sight-ai.onrender.com
VITE_API_BASE_URL=

# Firebase Authentication Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Serverless API / Backend Configuration (Vercel Server-Side ONLY - DO NOT prefix with VITE_)
# Set these in your Vercel Project Settings > Environment Variables:
SNS_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/inspectsight
SNS_WEBHOOK_SECRET=your_optional_sns_auth_token_or_secret
SNS_API_KEY=your_optional_sns_api_key

